      "required": [
        "content_json",
        "dataset_id",
        "date_label",
        "event_id",
        "evidence_status",
        "normalized_start",
        "summary"
      ],
      "type": "object"
    },
    "#TimelinePageRow": {
      "additionalProperties": false,
      "properties": {
        "character_count": {
          "minimum": 0,
          "type": "integer"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
