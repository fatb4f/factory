package inf1120a26

constraints: [
    {id: "constraint:quiz-no-retake", label: "Aucune reprise pour les quiz", scope: "submission", rule: "Aucune reprise n’est possible pour les quiz notés, peu importe la raison.", evidence: ["src:evaluation-agreement-a26"]},
    {id: "constraint:tp1-tp2-late", label: "Retard TP1/TP2", scope: "submission", rule: "TP1 et TP2: au plus 24 h de retard, avec pénalité de 10%; après 24 h, le travail n’est plus accepté et la note est 0.", evidence: ["src:evaluation-agreement-a26"]},
    {id: "constraint:tp3-no-late", label: "Aucun retard TP3", scope: "submission", rule: "TP3: aucun retard accepté; un TP3 en retard obtient 0.", evidence: ["src:evaluation-agreement-a26"]},
    {id: "constraint:exam-note-sheet", label: "Feuille de notes permise", scope: "exam", rule: "Une feuille de notes 8½ × 11 recto-verso est permise; aucun autre document.", evidence: ["src:exam-directives"]},
    {id: "constraint:exam-no-electronics", label: "Aucun équipement électronique", scope: "exam", rule: "Ordinateurs, tablettes, cellulaires, lecteurs et calculatrices sont interdits.", evidence: ["src:exam-directives"]},
    {id: "constraint:exam-student-card", label: "Carte étudiante obligatoire", scope: "exam", rule: "La carte étudiante est obligatoire et vérifiée.", evidence: ["src:exam-directives"]},
    {id: "constraint:exam-exit-terminal", label: "Sortie de salle terminale", scope: "exam", rule: "Sortir de la salle pendant l’examen implique remettre l’examen et ne pas revenir.", evidence: ["src:exam-directives"]},
    {id: "constraint:exam-three-hours", label: "Durée des examens", scope: "exam", rule: "La directive d’examen indique une durée de 3 heures.", evidence: ["src:exam-directives"]},
    {id: "constraint:javadoc-file", label: "Préambule Javadoc de fichier", scope: "documentation", rule: "Chaque fichier doit commencer par un bloc Javadoc contenant minimalement auteur, code permanent, courriel, date et description.", evidence: ["src:correction-criteria"]},
    {id: "constraint:javadoc-method", label: "Javadoc des méthodes", scope: "documentation", rule: "Chaque méthode doit être documentée par Javadoc avec paramètres, retour et exceptions selon le cas.", evidence: ["src:correction-criteria"]},
    {id: "constraint:meaningful-names", label: "Identificateurs significatifs", scope: "code", rule: "Classes, variables, constantes, paramètres et méthodes doivent recevoir des noms significatifs selon les conventions du cours.", evidence: ["src:style-conventions", "src:correction-criteria"]},
    {id: "constraint:declarations-at-start", label: "Déclarations au début de méthode", scope: "code", rule: "Les variables/constantes locales doivent être déclarées au début de leur méthode.", evidence: ["src:style-conventions", "src:correction-criteria"]},
    {id: "constraint:one-declaration-instruction-line", label: "Une déclaration / instruction par ligne", scope: "code", rule: "Une seule déclaration de variable par ligne et une seule instruction par ligne.", evidence: ["src:correction-criteria"]},
    {id: "constraint:indentation-braces", label: "Blocs, accolades et indentation", scope: "code", rule: "Accolade ouvrante en fin de ligne d’introduction du bloc, fermeture alignée et indentation constante par niveau.", evidence: ["src:style-conventions", "src:correction-criteria"]},
    {id: "constraint:line-length-120", label: "Lignes de 120 caractères maximum", scope: "code", rule: "Maximum de 120 caractères par ligne, indentation comprise.", evidence: ["src:style-conventions"]},
    {id: "constraint:single-return", label: "Au plus un return par méthode", scope: "code", rule: "Toute méthode doit avoir zéro ou un seul énoncé return; une méthode void n’en contient aucun.", evidence: ["src:correction-criteria"]},
    {id: "constraint:return-not-in-control", label: "Pas de return dans les structures de contrôle", scope: "code", rule: "Aucun return dans for, while, do...while, switch, if, try ou catch.", evidence: ["src:correction-criteria"]},
    {id: "constraint:break-switch-only", label: "break seulement dans switch", scope: "code", rule: "break est interdit ailleurs que dans switch et doit être la dernière instruction d’un case selon la règle du cours.", evidence: ["src:correction-criteria"]},
    {id: "constraint:no-continue", label: "continue interdit", scope: "code", rule: "L’instruction continue est interdite.", evidence: ["src:correction-criteria"]},
    {id: "constraint:no-while-true", label: "while(true) interdit", scope: "code", rule: "Les boucles while(true) sont interdites.", evidence: ["src:correction-criteria"]},
    {id: "constraint:for-control-discipline", label: "Discipline de variable de contrôle for", scope: "code", rule: "L’entête du for ne modifie que sa variable de contrôle; le corps ne doit pas modifier cette variable.", evidence: ["src:correction-criteria"]},
    {id: "constraint:boolean-directness", label: "Expressions booléennes directes", scope: "code", rule: "Éviter == true, == false, != true, != false et les if qui ne font qu’affecter true/false; affecter l’expression booléenne directement.", evidence: ["src:correction-criteria"]},
    {id: "constraint:no-globals", label: "Pas de variables globales", scope: "design", rule: "Les modules/méthodes communiquent par paramètres; éviter les variables globales.", evidence: ["src:correction-criteria", "src:methods"]},
    {id: "constraint:low-coupling-high-cohesion", label: "Faible couplage / forte cohésion", scope: "design", rule: "Le code doit favoriser faible couplage, forte cohésion, encapsulation, paramétrisation, étanchéité et spécialisation.", evidence: ["src:correction-criteria"]},
    {id: "constraint:short-robust-methods", label: "Méthodes courtes et robustes", scope: "design", rule: "Les méthodes, y compris main, doivent être courtes et robustes; main devrait normalement refléter l’algorithme de haut niveau.", evidence: ["src:correction-criteria"]},
    {id: "constraint:validate-inputs", label: "Validation syntaxique et logique", scope: "design", rule: "Valider les entrées et paramètres, y compris données invalides, valeurs limites et null selon le contexte.", evidence: ["src:correction-criteria"]},
]
