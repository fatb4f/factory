        "page_id": {
          "$ref": "#/$defs/%23ID"
        },
        "source_id": {
          "$ref": "#/$defs/%23ID"
        },
        "text": {
          "type": "string"
        },
        "text_path": {
          "type": "string"
        },
        "text_sha256": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        }
      },
      "required": [
        "character_count",
        "dataset_id",
        "page",
        "page_id",
        "source_id",
        "text",
        "text_path",
        "text_sha256"
      ],
      "type": "object"
    },
    "#TimelinePayloadRow": {
      "additionalProperties": false,
      "properties": {
        "character_count": {
          "minimum": 0,
          "type": "integer"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "payload_id": {
          "$ref": "#/$defs/%23ID"
        },
        "source_id": {
          "$ref": "#/$defs/%23ID"
        },
        "text": {
          "type": "string"
        },
        "text_path": {
          "type": "string"
        },
        "text_sha256": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        }
