      "required": [
        "authority",
        "coverage_json",
        "dataset_id",
        "exchange_sha256",
        "format",
        "gaps_json",
        "version"
      ],
      "type": "object"
    },
    "#TimelineEventRow": {
      "additionalProperties": false,
      "properties": {
        "content_json": {
          "type": "string"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "date_label": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/%23ID"
        },
        "evidence_status": {
          "type": "string"
        },
        "normalized_start": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
