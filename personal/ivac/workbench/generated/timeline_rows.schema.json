        "mime_type": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "raw_path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "raw_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "role": {
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/%23ID"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "null"
