{
  "$defs": {
    "#ID": {
      "minLength": 1,
      "type": "string"
    },
    "#RegulatoryDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "#TimelineAliasRow": {
      "additionalProperties": false,
      "properties": {
        "alias_id": {
          "$ref": "#/$defs/%23ID"
        },
        "basis": {
          "enum": [
            "original-artifact-digest",
            "original-and-text-digests"
          ]
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "source_id": {
          "$ref": "#/$defs/%23ID"
        }
      },
      "required": [
        "alias_id",
        "basis",
        "dataset_id",
        "source_id"
      ],
      "type": "object"
    },
    "#TimelineAnchorRow": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "$ref": "#/$defs/%23ID"
        },
        "content_json": {
          "type": "string"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "end": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "integrity": {
          "enum": [
            "exact-verified",
            "locator-only",
            "unresolved-source"
          ]
        },
        "original_source_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "owner_id": {
          "$ref": "#/$defs/%23ID"
        },
        "owner_kind": {
          "enum": [
            "event",
            "vector",
            "assessment",
            "comparison"
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "position": {
          "minimum": 0,
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "review": {
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "text_path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "text_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "anchor_id",
        "content_json",
        "dataset_id",
        "end",
        "integrity",
        "original_source_id",
        "owner_id",
        "owner_kind",
        "page",
        "position",
        "quote",
        "review",
        "source_id",
        "start",
        "text_path",
        "text_sha256"
      ],
      "type": "object"
    },
    "#TimelineAssessmentRow": {
      "additionalProperties": false,
      "properties": {
        "assessment_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "assessment_id": {
          "$ref": "#/$defs/%23ID"
        },
        "assessor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "class_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "content_json": {
          "type": "string"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "kind": {
          "type": "string"
        },
        "percentage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            }
          ]
        },
        "percentage_state": {
          "enum": [
            "recorded",
            "unknown",
            "opaque"
          ]
        },
        "review_status": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "assessment_date",
        "assessment_id",
        "assessor",
        "class_label",
        "content_json",
        "dataset_id",
        "kind",
        "percentage",
        "percentage_state",
        "review_status",
        "source_id"
      ],
      "type": "object"
    },
    "#TimelineComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "automatic_selection": {
          "const": false
        },
        "comparison_id": {
          "$ref": "#/$defs/%23ID"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "difference": {
          "type": "string"
        },
        "left_assertion": {
          "type": "string"
        },
        "origin_path": {
          "type": "string"
        },
        "right_assertion": {
          "type": "string"
        },
        "status": {
          "const": "candidate-unresolved"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "dataset_id",
        "difference",
        "left_assertion",
        "origin_path",
        "right_assertion",
        "topic"
      ],
      "type": "object"
    },
    "#TimelineDatasetRow": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string"
        },
        "coverage_json": {
          "type": "string"
        },
        "dataset_id": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "exchange_sha256": {
          "$ref": "#/$defs/%23RegulatoryDigest"
        },
        "format": {
          "type": "string"
        },
        "gaps_json": {
          "type": "string"
        },
        "semantic_admission": {
          "const": "none"
        },
        "version": {
          "type": "string"
        }
